    "archive.empty.body": {
      "comment": "15.3, adaptada ao nome novo (D-10)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A note you've handled is a note you finish."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilhete resolvido é bilhete concluído."
          }
        }
      }
    },
