    "badge.pro": {
      "comment": "Selo de capacidade Pro (matriz da seção 5)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PRO"
          }
        }
      }
    },
    "concepts.done.body": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the \"I've handled it\". The note leaves the screen and goes to Done, where you can bring it back if you need. The Done button on the Lock Screen does exactly the same thing, without opening the app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o \"resolvi isso\". O bilhete sai da tela e vai para Concluídos, de onde pode voltar se você precisar. O botão Concluir da tela de bloqueio faz exatamente a mesma coisa, sem abrir o app."
          }
        }
      }
    },
    "concepts.done.title": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concluir"
          }
        }
      }
    },
    "concepts.intro": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One note at a time is featured — and that's the one that shows on your Lock Screen. The rest wait their turn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um bilhete por vez fica em destaque — e é ele que aparece na sua tela de bloqueio. O resto espera a vez."
          }
        }
      }
    },
    "concepts.limits.body": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Pro, three active notes at a time — the featured one plus the ones you put away. Done notes don't count."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem o Pro, três bilhetes ativos ao mesmo tempo — o em destaque mais os guardados. Os concluídos não contam."
          }
        }
      }
    },
    "concepts.limits.title": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many fit"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos cabem"
          }
        }
      }
    },
    "concepts.pin.body": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the note big on the Lock Screen, for 8 hours. After that iPhone ends it on its own — a system limit, not the app's — and you pin it again whenever you want."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe o bilhete grande na tela de bloqueio, por 8 horas. Depois disso o iPhone encerra sozinho — é limite do sistema, não do app — e você fixa de novo quando quiser."
          }
        }
      }
    },
    "concepts.pin.title": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixar"
          }
        }
      }
    },
    "concepts.stash.body": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the note to the stack and opens a blank one. It's the \"not now\": it stays active and comes back with one tap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manda o bilhete para a pilha e abre um novo em branco. É o \"agora não\": ele continua ativo e volta ao destaque com um toque."
          }
        }
      }
    },
    "concepts.stash.title": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put away"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar"
          }
        }
      }
    },
    "concepts.title": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Bilhete works"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o Bilhete funciona"
          }
        }
      }
    },
    "concepts.unpin.body": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes the note off the Lock Screen without finishing it. It stays featured in the app, untouched."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira o bilhete da tela de bloqueio sem concluir. Ele continua em destaque no app, inteiro."
          }
        }
      }
    },
    "concepts.unpin.title": {
      "comment": "D-10",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpin"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Soltar"
          }
        }
      }
    },
