          }
        }
      }
    },
    "editor.placeholder": {
      "comment": "15.1 — placeholder e seed (7.7)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write what you don't want to forget"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva o que você não quer esquecer"
          }
        }
      }
    },
    "error.save.body": {
      "comment": "15.5",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your text is still here. I'll try again shortly."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu texto continua aqui. Vou tentar de novo em instantes."
          }
        }
      }
    },
    "error.save.title": {
      "comment": "15.5",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save right now"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegui salvar agora"
          }
        }
      }
    },
    "guide.card.body": {
      "comment": "9.4",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the widget it stays for good. Tap to see how."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o widget ele fica pra sempre. Toque pra ver como."
          }
        }
      }
    },
    "guide.card.title": {
      "comment": "9.4 — cartão dispensável no rodapé do destaque",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your note leaves the screen in 12 hours"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu bilhete some da tela em 12 horas"
          }
        }
      }
    },
    "guide.done": {
      "comment": "10.7 — botão de fechar",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto"
          }
        }
      }
    },
    "guide.step1.body": {
      "comment": "10.7 — bloco 1",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold the Lock Screen, tap Customize, pick the screen and tap the area below the clock. Look for Bilhete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure a tela de bloqueio, toque em Personalizar, escolha a tela e toque na área abaixo do relógio. Procure por Bilhete."
          }
        }
      }
    },
    "guide.step1.title": {
      "comment": "10.7 — bloco 1",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lock Screen widget"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O widget na tela de bloqueio"
          }
        }
      }
    },
    "guide.step2.body": {
      "comment": "10.7 — bloco 2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the same customize screen, tap the flashlight or camera button and swap it for Pin note again. One tap puts your note back on the screen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na mesma tela de personalizar, toque no botão da lanterna ou da câmera e troque por Refixar bilhete. Um toque devolve seu bilhete pra tela."
          }
        }
      }
    },
    "guide.step2.title": {
      "comment": "10.7 — bloco 2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The control instead of the flashlight"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Controle no lugar da lanterna"
          }
        }
      }
    },
    "guide.step3.body": {
      "comment": "10.7 — bloco 3, explica L1 e L2",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The big highlight is a Live Activity, and iPhone ends every Live Activity after 12 hours. The widget has no such limit — that's why it's what holds your note."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O destaque grande é uma Atividade ao Vivo, e o iPhone encerra toda Atividade ao Vivo depois de 12 horas. O widget não tem esse limite — por isso ele é o que segura seu bilhete."
          }
        }
      }
    },
    "guide.step3.title": {
      "comment": "10.7 — bloco 3",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why the note leaves the screen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que o bilhete sai da tela"
          }
        }
      }
    },
    "guide.title": {
      "comment": "10.7",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to put it on the Lock Screen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como colocar na tela de bloqueio"
          }
        }
      }
    },
    "hint.flow": {
      "comment": "10.1 — explicação do fluxo, mostrada enquanto a pessoa ainda não guardou nem concluiu nada",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One note at a time. Pin puts it on the Lock Screen; Put away is for later; Done is when you've handled it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um bilhete por vez na tela. Fixar põe ele na tela de bloqueio; Guardar deixa pra depois; Concluir é quando você resolveu."
          }
        }
      }
