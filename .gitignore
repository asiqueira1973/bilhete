# O projeto do Xcode é gerado pelo XcodeGen a partir do project.yml — versionar
# os dois faria o .xcodeproj virar fonte de conflito a cada `xcodegen generate`.
# Quem clona roda `xcodegen generate` (ver README).
Bilhete.xcodeproj/

# Artefatos de build
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM.zip
*.dSYM

# Estado local do Xcode
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/

# macOS
.DS_Store

# --- Segredos e credenciais (nunca versionar) ---
.env
.env.*
!.env.example
GoogleService-Info.plist
google-services.json
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
key.properties
local.properties
secrets/
